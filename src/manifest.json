{
  "name": "Inject CSS into Cross-Origin",
  "version": "1.0",
  "manifest_version": 3,
  "description": "Inject custom CSS into cross-origin",
  "permissions": ["scripting", "activeTab"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["styles.css"],
      "all_frames": true
    }
  ]
}
